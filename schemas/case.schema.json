{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaBuyerBench case",
  "type": "object",
  "required": ["id", "title", "provider", "category", "difficulty", "business", "user_prompt", "data", "expected"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "provider": {"type": "string"},
    "category": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "business": {"type": "object"},
    "user_prompt": {"type": "string"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "notes": {"type": "string"},
          "rows": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "required_concepts": {"type": "array"},
        "required_assertions": {"type": "array"},
        "forbidden_concepts": {"type": "array"},
        "quality_contract": {
          "type": "object",
          "required": ["criteria"],
          "properties": {
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "description", "weight", "severity"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "description": {"type": "string", "minLength": 1},
                  "weight": {"type": "number", "exclusiveMinimum": 0},
                  "severity": {"type": "string", "enum": ["required", "critical"]},
                  "pillar": {
                    "type": "string",
                    "enum": ["evidence_math", "inference", "action_safety", "validation"]
                  },
                  "acceptable_alternatives": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            },
            "scoring_note": {"type": "string"}
          }
        },
        "safety_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "type": {"type": "string", "enum": ["contains_any", "contains_none", "requires_any", "number"]},
              "phrases": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "context": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "value": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0},
              "severity": {"type": "string", "enum": ["required", "critical"]}
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {"enum": ["contains_any", "contains_none", "requires_any"]}
                  }
                },
                "then": {"required": ["phrases"]}
              },
              {
                "if": {
                  "properties": {"type": {"const": "number"}}
                },
                "then": {"required": ["value", "context"]}
              }
            ]
          }
        }
      }
    }
  }
}
