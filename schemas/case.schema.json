{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaBuyerBench case",
  "type": "object",
  "required": ["id", "title", "provider", "category", "difficulty", "business", "user_prompt", "data", "expected"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "provider": {"type": "string"},
    "category": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "business": {"type": "object"},
    "user_prompt": {"type": "string"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "notes": {"type": "string"},
          "rows": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["required_concepts"],
      "properties": {
        "required_concepts": {"type": "array"},
        "forbidden_concepts": {"type": "array"},
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion"],
            "properties": {
              "criterion": {"type": "string"},
              "expected": {"type": "string", "enum": ["flag", "act", "respect", "avoid"]},
              "weight": {"type": "number"},
              "penalty": {"type": "number"},
              "skills": {"type": "array", "items": {"type": "string"}},
              "threshold_override": {"type": "object"},
              "detect": {"type": "array", "items": {"type": "string"}},
              "data_check": {
                "type": "object",
                "required": ["block", "select"],
                "properties": {
                  "block": {"type": "string"},
                  "select": {"type": "string"},
                  "where": {"type": "object"}
                }
              }
            }
          }
        }
      }
    }
  }
}
