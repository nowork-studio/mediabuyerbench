{
  "id": "cross_channel_platform_cpa_lies_001",
  "title": "Meta platform CPA looks cheaper than Google but lead quality differs",
  "provider": "cross_channel",
  "category": "budget_allocation",
  "difficulty": "hard",
  "business": {
    "vertical": "B2B SaaS",
    "acv": "$8,000",
    "sales_cycle": "45-90 days",
    "goal": "sales-qualified opportunities",
    "current_question": "shift budget from Google Search to Meta"
  },
  "user_prompt": "Meta shows cheaper CPA than Google. Should we move budget from Google to Meta?",
  "data": [
    {
      "name": "Platform-reported results, last 30 days",
      "rows": [
        {"channel": "Google Search", "spend": 9000, "platform_conversions": 90, "platform_cpa": 100},
        {"channel": "Meta", "spend": 7000, "platform_conversions": 140, "platform_cpa": 50}
      ]
    },
    {
      "name": "CRM quality, same cohort",
      "rows": [
        {"channel": "Google Search", "leads": 84, "sqls": 21, "opportunities": 8, "pipeline": 64000},
        {"channel": "Meta", "leads": 132, "sqls": 9, "opportunities": 2, "pipeline": 16000}
      ]
    },
    {
      "name": "Attribution notes",
      "rows": [
        {"item": "Meta", "value": "Includes 7-day click and 1-day view attribution"},
        {"item": "Google", "value": "Mostly non-brand high-intent search"},
        {"item": "Retargeting", "value": "Meta includes prospecting and retargeting in same report"}
      ]
    }
  ],
  "expected": {
    "required_concepts": [
      {
        "id": "dont_shift_on_platform_cpa",
        "label": "Rejects budget shift based only on platform CPA",
        "phrases": ["do not move budget", "don't shift", "not based on platform cpa", "platform cpa", "not enough"],
        "weight": 3,
        "skills": ["budget_allocation", "safety", "cross_channel"]
      },
      {
        "id": "crm_truth",
        "label": "Uses CRM SQL/opportunity quality as source of truth",
        "phrases": ["crm", "sql", "sales-qualified", "opportunity", "pipeline"],
        "weight": 3,
        "skills": ["business_economics", "measurement", "cross_channel"]
      },
      {
        "id": "attribution_caveat",
        "label": "Flags Meta view-through/attribution inflation",
        "phrases": ["view-through", "attribution", "7-day click", "1-day view", "inflated"],
        "weight": 2,
        "skills": ["measurement", "meta_ads"]
      },
      {
        "id": "separate_prospecting_retargeting",
        "label": "Separates prospecting from retargeting",
        "phrases": ["prospecting", "retargeting", "separate", "split"],
        "weight": 1,
        "skills": ["cross_channel", "action_plan"]
      },
      {
        "id": "compare_pipeline_cac",
        "label": "Recommends comparing CAC to qualified pipeline/revenue",
        "phrases": ["cac", "pipeline", "revenue", "qualified", "payback"],
        "weight": 1,
        "skills": ["business_economics", "budget_allocation"]
      }
    ],
    "forbidden_concepts": [
      {
        "id": "move_to_meta",
        "label": "Moves budget to Meta because platform CPA is cheaper",
        "phrases": ["move budget to meta", "shift budget to meta", "meta is cheaper so"],
        "penalty": 40
      },
      {
        "id": "ignore_quality",
        "label": "Optimizes only to lead volume",
        "phrases": ["maximize leads", "lead volume is the goal", "more leads at lower cpa"],
        "penalty": 25
      }
    ],
    "rubric": [
      {
        "criterion": "xc.attribution.platform_cpa_vs_truth",
        "expected": "flag",
        "weight": 3,
        "skills": ["budget_allocation", "cross_channel", "business_economics"],
        "detect": ["platform cpa", "crm", "sql", "pipeline", "quality"]
      },
      {
        "criterion": "xc.attribution.window_mismatch",
        "expected": "flag",
        "weight": 2,
        "skills": ["measurement", "meta_ads"],
        "detect": ["view-through", "7-day click", "1-day view", "attribution", "inflated"]
      },
      {
        "criterion": "gen.diagnosis.preserve_converters",
        "expected": "respect",
        "weight": 2,
        "skills": ["budget_allocation", "cross_channel"],
        "note": "the channel to protect is the one producing real pipeline/opportunities (Google Search), derived from CRM data.",
        "data_check": {
          "block": "CRM quality, same cohort",
          "where": {"opportunities": {">=": 8}},
          "select": "channel"
        },
        "detect": ["google", "keep", "do not move budget", "pipeline"]
      },
      {
        "criterion": "gen.safety.no_premature_budget_change",
        "expected": "avoid",
        "weight": 1.5,
        "skills": ["safety", "budget_allocation"],
        "penalty": 30,
        "detect": ["move budget to meta", "shift budget to meta", "meta is cheaper so"]
      },
      {
        "criterion": "gen.measurement.use_rate_denominators",
        "expected": "respect",
        "weight": 1.5,
        "skills": ["business_economics", "measurement"],
        "detect": ["cac", "pipeline per", "cost per opportunity", "sql rate", "conversion rate"]
      }
    ]
  }
}
