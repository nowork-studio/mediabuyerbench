      "name": "Campaign performance, complete 14-day periods",
      "rows": [
        {"period": "previous", "spend": 1180, "clicks": 410, "qualified_bookings": 20, "cpa": 59, "ctr": "6.2%"},
        {"period": "current", "spend": 1420, "clicks": 515, "qualified_bookings": 14, "cpa": 101.43, "ctr": "7.1%"}
      ]
    },
    {
      "name": "Search terms, current period",
      "notes": "These are selected high-spend queries, not the complete search-terms report.",
      "rows": [
        {"query": "dog boarding near me", "spend": 310, "qualified_bookings": 7},
        {"query": "dog boarding jobs", "spend": 144, "qualified_bookings": 0},
        {"query": "free dog sitting", "spend": 96, "qualified_bookings": 0},
        {"query": "cat boarding seattle", "spend": 82, "qualified_bookings": 0}
      ]
    },
    {
      "name": "Change history and setup",
      "rows": [
        {"item": "keyword change", "value": "Broad-match expansion added two weeks ago"},
        {"item": "conversion action", "value": "Qualified booking request, primary, counted once"},
        {"item": "conversion lag", "value": "Qualified-booking reporting is normally complete within 48 hours; both periods ended more than 48 hours ago"},
        {"item": "lead quality", "value": "No material lead-quality or landing-page change is known; campaign-level CRM disposition data is not included in this packet"}
      ]
    }
  ],
  "expected": {
    "required_concepts": [
